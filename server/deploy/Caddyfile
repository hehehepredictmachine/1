# Caddy terminates HTTPS (automatic certificate) and forwards to mqlicense on 127.0.0.1:8790. Change the domain.
licencje.twoja-domena.pl {
	encode gzip
	request_body {
		max_size 64KB
	}
	reverse_proxy 127.0.0.1:8790 {
		header_up X-Forwarded-For {remote_host}
	}
	log {
		# access log WITHOUT request bodies (license keys travel only in POST bodies, never in URLs)
		output file /var/log/caddy/mqlicense.log
	}
}
