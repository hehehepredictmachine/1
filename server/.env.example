# MasterQUO central server - EXAMPLE configuration (no secrets here). Copy to .env, fill in, chmod 600.
# Generate keys:  python -m mqcentral gen-keys   (prints MQC_SIGNING_KEY_FILE / MQC_DATA_KEY)

MQC_ENV=production
# PostgreSQL (production). SQLite is accepted ONLY with MQC_ENV=dev.
MQC_DATABASE_URL=postgresql://mqcentral:CHANGE_ME@127.0.0.1:5432/mqcentral
# Public HTTPS address of this server (= lease issuer, links in e-mails, address typed in the clients)
MQC_PUBLIC_URL=https://licencje.twojadomena.pl
MQC_ALLOWED_ORIGINS=https://licencje.twojadomena.pl
# Ed25519 private key for leases (server only, chmod 600) and Fernet key for TOTP secrets
MQC_SIGNING_KEY_FILE=/opt/mqcentral/secrets/lease_signing_ed25519.pem
MQC_DATA_KEY=
# E-mail (required in production - verification / reset / invitations are never skipped)
MQC_MAIL_MODE=smtp
MQC_SMTP_HOST=smtp.twojadomena.pl
MQC_SMTP_PORT=587
MQC_SMTP_USER=
MQC_SMTP_PASSWORD=
MQC_SMTP_FROM=MasterQUO <licencje@twojadomena.pl>
MQC_SMTP_STARTTLS=1
# Cookies Secure + __Host- prefix (must stay 1 in production)
MQC_SECURE_COOKIES=1
# Behind Caddy/nginx on the same host: trust X-Forwarded-For from 127.0.0.1
MQC_TRUSTED_PROXY=1
MQC_HOST=127.0.0.1
MQC_PORT=8800
# Optional clock monitoring: HTTPS server whose Date header is compared (anomaly -> no new rights until clock-ack)
MQC_TIME_REFERENCE_URL=https://www.google.com
