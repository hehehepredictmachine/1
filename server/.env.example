# MasterQUO License Server - przykładowa konfiguracja. Skopiuj jako .env (chmod 600). NIE commituj .env ani sekretów.
# Sekrety generuje: python -m mqlicense gen-keys --out secrets   (dopisz zawartość secrets/secrets.env poniżej)
MQL_ENV=prod
MQL_PUBLIC_URL=https://licencje.twoja-domena.pl
MQL_ALLOWED_ORIGINS=https://licencje.twoja-domena.pl
MQL_DB_PATH=/opt/mqlicense/data/mqlicense.sqlite3
MQL_SIGNING_KEY_FILE=/opt/mqlicense/secrets/signing_ed25519.pem
MQL_KEY_PEPPER=
MQL_DATA_KEY=
# stałe zasady produktu (serwer w trybie prod odrzuca inne wartości): licencja 259200 s, dzierżawa <= 30 s
MQL_LICENSE_SECONDS=259200
MQL_LEASE_SECONDS=30
MQL_DEFAULT_MAX_SESSIONS=1
MQL_ADMIN_SESSION_MINUTES=60
MQL_HOST=127.0.0.1
MQL_PORT=8790
# 1 tylko za własnym reverse proxy (Caddy/nginx) na tej samej maszynie
MQL_TRUST_PROXY=1
