# Copy to /etc/pmw-license.env (chmod 600, owner = the service user). Never commit the real file.
PMW_LIC_ENV=production
PMW_LIC_HOST=127.0.0.1
PMW_LIC_PORT=8740
PMW_LIC_DATABASE=/var/lib/pmw-license/licenses.db
PMW_LIC_SIGNING_KEY=/etc/pmw-license/signing_key.pem
# python -m pmw_license new-pepper
PMW_LIC_KEY_PEPPER=replace_me
PMW_LIC_ADMIN_USER=replace_me
# python -m pmw_license hash-password
PMW_LIC_ADMIN_PASSWORD_HASH=replace_me
PMW_LIC_TRUST_PROXY=1
PMW_LIC_RATE_PUBLIC_PER_MIN=30
PMW_LIC_RATE_LOGIN_PER_MIN=5
PMW_LIC_ADMIN_SESSION_HOURS=8
