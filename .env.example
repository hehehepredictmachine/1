# MasterQUO AI - opcjonalne zmienne lokalne. Skopiuj jako .env (plik .env nie jest pakowany ani commitowany).
# Z tego pliku program wczytuje WYŁĄCZNIE: ANTHROPIC_API_KEY, ANTHROPIC_MODEL, MASTERQUO_DATA_DIR, FRED_API_KEY, TELEGRAM_BOT_TOKEN
# (inne wpisy są pomijane; zmienna ustawiona już w środowisku systemu ma pierwszeństwo). Pozostałe sekrety ustawia się w monitorze.

# --- AI (Claude) -------------------------------------------------------------------------------------------------
# Zalecane: klucz wpisz w monitorze (Ustawienia -> Agent Claude) - zostanie zaszyfrowany Windows DPAPI.
# Bez klucza monitor pokazuje "AI NIEDOSTĘPNE", a sygnały pochodzą tylko ze strategii.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Inne ---------------------------------------------------------------------------------------------------------
FRED_API_KEY=
TELEGRAM_BOT_TOKEN=
# Opcjonalnie inny folder danych (domyślnie <folder programu>\data):
# MASTERQUO_DATA_DIR=
