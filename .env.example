# MasterQUO AI - opcjonalne zmienne lokalne. Skopiuj jako .env (plik .env nie jest pakowany ani commitowany).
# Odczytywane są WYŁĄCZNIE zmienne wymienione poniżej.

# --- AI (Claude) -------------------------------------------------------------------------------------------------
# Zalecane: klucz wpisz w monitorze (Ustawienia -> Agent Claude) - zostanie zaszyfrowany Windows DPAPI.
# Bez klucza monitor pokazuje "AI NIEDOSTĘPNE", a sygnały pochodzą tylko ze strategii.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Serwer licencji ----------------------------------------------------------------------------------------------
# Adres Twojego serwera licencji (https://; http:// tylko 127.0.0.1/localhost) i plik z jego KLUCZEM PUBLICZNYM.
# Alternatywnie: sekcja "license" w data\config.json (server_url, public_key_pem).
# KLUCZA LICENCJI NIE WPISUJE SIĘ TUTAJ - wklejasz go przy każdym uruchomieniu masterquo_start.bat (nie jest nigdzie zapisywany).
MASTERQUO_LICENSE_SERVER_URL=
MASTERQUO_LICENSE_PUBLIC_KEY_FILE=

# --- Inne ---------------------------------------------------------------------------------------------------------
FRED_API_KEY=
TELEGRAM_BOT_TOKEN=
