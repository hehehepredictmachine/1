{
  "module_version": "1.1.0",
  "schema_version": "2.0.0",
  "prompt_version": "4.1.0",
  "poll_seconds": 300,
  "item_max_age_hours": 48,
  "max_recent_items": 80,
  "calendar_pre_minutes": 45,
  "calendar_post_minutes": 30,
  "allowed_hosts": [
    "www.federalreserve.gov",
    "www.bls.gov",
    "api.gdeltproject.org",
    "api.stlouisfed.org",
    "nfs.faireconomy.media"
  ],
  "rss_feeds": [
    {
      "id": "FED_MONETARY",
      "url": "https://www.federalreserve.gov/feeds/press_monetary.xml",
      "authority": "OFFICIAL",
      "category": "FED"
    },
    {
      "id": "FED_SPEECHES",
      "url": "https://www.federalreserve.gov/feeds/speeches.xml",
      "authority": "OFFICIAL",
      "category": "FED"
    },
    {
      "id": "BLS_CPI",
      "url": "https://www.bls.gov/feed/cpi.rss",
      "authority": "OFFICIAL",
      "category": "INFLATION"
    },
    {
      "id": "BLS_EMPLOYMENT",
      "url": "https://www.bls.gov/feed/empsit.rss",
      "authority": "OFFICIAL",
      "category": "LABOR"
    },
    {
      "id": "BLS_PPI",
      "url": "https://www.bls.gov/feed/ppi.rss",
      "authority": "OFFICIAL",
      "category": "INFLATION"
    }
  ],
  "bls_calendar_ics": "https://www.bls.gov/schedule/news_release/bls.ics",
  "gdelt_enabled": true,
  "gdelt_queries": [
    {
      "id": "GOLD_MARKET",
      "query": "(gold OR XAUUSD OR bullion OR \"gold prices\")",
      "category": "GOLD"
    },
    {
      "id": "USD_RATES",
      "query": "(\"US dollar\" OR \"US Treasury yields\" OR \"Federal Reserve\" OR \"rate cuts\")",
      "category": "USD_RATES"
    },
    {
      "id": "GEOPOLITICAL",
      "query": "(geopolitical OR sanctions OR war OR ceasefire) (gold OR oil OR markets)",
      "category": "GEOPOLITICS"
    },
    {
      "id": "PHYSICAL_GOLD",
      "query": "(\"central bank gold\" OR \"gold ETF\" OR \"gold reserves\" OR \"gold purchases\")",
      "category": "PHYSICAL_GOLD"
    }
  ],
  "fred_enabled": true,
  "fred_series": [
    "DGS10",
    "DFII10",
    "T10YIE",
    "DFF",
    "UNRATE",
    "PAYEMS",
    "CPIAUCSL",
    "PCEPI",
    "DTWEXBGS"
  ],
  "fred_interval_seconds": 3600,
  "calendar_interval_seconds": 900,
  "rss_interval_seconds": 300,
  "gdelt_interval_seconds": 600,
  "source_max_errors": 2,
  "fair_economy_interval_seconds": 1800,
  "fair_economy_calendars": [
    {
      "id": "FF_CALENDAR",
      "provider": "Forex Factory",
      "enabled": true,
      "url": "https://nfs.faireconomy.media/ff_calendar_thisweek.json",
      "public_calendar_url": "https://www.forexfactory.com/calendar",
      "country_filter": [
        "USD",
        "CNY",
        "XAU"
      ],
      "include_metals_events": false
    },
    {
      "id": "MM_CALENDAR",
      "provider": "Metals Mine",
      "enabled": true,
      "url": "https://nfs.faireconomy.media/mm_calendar_thisweek.json",
      "public_calendar_url": "https://www.metalsmine.com/calendar",
      "country_filter": [
        "USD",
        "CNY",
        "XAU"
      ],
      "include_metals_events": true
    }
  ]
}
